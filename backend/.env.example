# ===== 应用 =====
APP_NAME=AI 新闻聚合与问答系统
DEBUG=true

# ===== 数据库 =====
DB_URL=mysql+aiomysql://user:password@127.0.0.1:3306/news_ai?charset=utf8mb4
DB_ECHO=false

# ===== DeepSeek =====
# 在 https://platform.deepseek.com 申请
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL_FAST=deepseek-flash
DEEPSEEK_MODEL_PRO=deepseek-v4-pro
LLM_TIMEOUT=120
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.3
LLM_SEND_EFFORT=false

# 价格（元 / 百万 token，仅用于成本估算展示）
PRICE_IN_FAST=0.5
PRICE_OUT_FAST=2.0
PRICE_IN_PRO=2.0
PRICE_OUT_PRO=8.0

# ===== JWT =====
JWT_SECRET=please-change-this-to-a-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# ===== 向量检索 =====
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DIM=512
EMBEDDING_CACHE_DIR=.cache/fastembed
# 国内网络建议保留镜像
HF_ENDPOINT=https://hf-mirror.com
RAG_TOP_K=6
RAG_CHUNK_SIZE=300
RAG_CHUNK_OVERLAP=60
RAG_MIN_SCORE=0.30

# ===== 采集（手动触发）=====
COLLECT_PER_FEED=15
COLLECT_HOT_LIMIT=0
KEEP_PER_SOURCE=200
KEEP_MAX_ROWS=5000
REFRESH_COOLDOWN=60

# ===== 缓存 =====
CACHE_TTL=3600
CACHE_MAX_ITEMS=512
